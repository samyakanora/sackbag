# Example environment variables (do NOT store secrets here)
# Copy to .env and fill in values as needed.

# Model weights (leave as the provided path)
WEIGHTS=runs/detect/train/weights/best.pt

# Offline/RTSP line references (either normalized 0..1 or reference-pixel coords)
LINE_OFFLINE=12,227,467,0
LINE_RTSP=12,227,467,0

# Reference resolution used to scale pixel coords to the actual frame size
REFERENCE_WIDTH=582
REFERENCE_HEIGHT=328

# Detection confidences
CONF_OFFLINE=0.40
CONF_RTSP=0.35

# Class and optional override id
CLASS_NAME=Sack
CLASS_ID=

# RTSP / telegram (do not commit secrets)
RTSP_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
