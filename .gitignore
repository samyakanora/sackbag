# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
!.env.example
.pytest_cache/
.mypy_cache/

# OS
.DS_Store

# Outputs and runtime artifacts
# Ignore prediction outputs and verification artifacts
runs/detect/predict*/
runs/detect/verify*/

# Specific training run artifacts we don't want to commit
runs/detect/train/args.yaml
runs/detect/train/results.csv
runs/detect/train/weights/last.pt

# Ignore generated videos and temporary images
*.mp4
*.mov
*.avi
*.db
sack_counts.db
*.jpg
*.jpeg
*.png
*.log

# Training datasets and artifacts (do not commit large datasets)
train/
valid/
test/
data.yaml
README.dataset.txt
README.roboflow.txt
yolo11n.pt

# Ignore all other weights by default, but keep `best.pt` tracked
runs/detect/train/weights/*.pt
!runs/detect/train/weights/best.pt

# IDE
.vscode/
